   "tokenColors": [
      {
         "name": "Variables, Attributes, and Properties",
         "scope": [
            "entity.other.attribute-name",
            "variable",
            "variable.other",
            "support.type.property-name",
            "meta.object-literal.key",
            "punctuation.support.type.property-name",
            "meta.object-literal.key punctuation.definition.string.begin",
            "meta.object-literal.key punctuation.definition.string.end",
            "support.type.property-name.json punctuation.definition.string.begin",
            "support.type.property-name.json punctuation.definition.string.end"
         ],
         "settings": {
            "foreground": "#9CDCFE"
         }
      },
      {
         "name": "Keywords, Booleans, and Tags",
         "scope": [
            "keyword",
            "constant.language.boolean",
            "constant.language.json",
            "constant.language",
            "storage.type",
            "storage.modifier",
            "entity.name.tag"
         ],
         "settings": {
            "foreground": "#569CD6"
         }
      },
      {
         "name": "Comments",
         "scope": [
            "comment",
            "comment.block.documentation",
            "punctuation.definition.comment"
         ],
         "settings": {
            "foreground": "#6A9955"
         }
      },
      {
         "name": "Constants",
         "scope": [
            "variable.other.constant",
            "entity.name.constant"
         ],
         "settings": {
            "foreground": "#4FC1FF"
         }
      },
      {
         "name": "Types, Classes, Constructors, and Enums",
         "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.type",
            "entity.name.type.enum",
            "new.expr entity.name.type"
         ],
         "settings": {
            "foreground": "#4EC9B0"
         }
      },
      {
         "name": "Functions, Titles, and Labels",
         "scope": [
            "entity.name.function",
            "support.function",
            "entity.name.section",
            "entity.name.label"
         ],
         "settings": {
            "foreground": "#DCDCAA"
         }
      },
      {
         "name": "Italics",
         "scope": [
            "markup.italic"
         ],
         "settings": {
            "foreground": "#D4D4D4",
            "fontStyle": "italic"
         }
      },
      {
         "name": "Bold",
         "scope": [
            "markup.bold"
         ],
         "settings": {
            "foreground": "#D4D4D4",
            "fontStyle": "bold"
         }
      },
      {
         "name": "Numbers",
         "scope": [
            "constant.numeric"
         ],
         "settings": {
            "foreground": "#B5CEA8"
         }
      },
      {
         "name": "Punctuation, Operators, and Embedded Text",
         "scope": [
            "punctuation",
            "operator",
            "markup.list",
            "punctuation.bracket",
            "punctuation.delimiter"
         ],
         "settings": {
            "foreground": "#D4D4D4"
         }
      },
      {
         "name": "Strings and Literals",
         "scope": [
            "string",
            "string.regexp",
            "markup.inline.raw",
            "punctuation.definition.string.begin",
            "punctuation.definition.string.end",
            "punctuation.definition.string"
         ],
         "settings": {
            "foreground": "#CE9178"
         }
      },
      {
         "name": "String Escapes",
         "scope": [
            "constant.character.escape"
         ],
         "settings": {
            "foreground": "#D7BA7D"
         }
      },
      {
         "name": "Doctype Tag",
         "scope": [
            "keyword.other.doctype"
         ],
         "settings": {
            "foreground": "#569CD6",
            "fontStyle": "italic"
         }
      }
   ]
}